# Vercel не принимает симлинки внутри бандла serverless-функции, а pnpm по умолчанию
# делает node_modules/<пакет> симлинком в .pnpm. Из-за этого бинарник ffmpeg,
# добавленный через outputFileTracingIncludes, ломал деплой с ошибкой
# "invalid deployment package for a Serverless Function".
node-linker=hoisted
